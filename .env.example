# ==============================================================================
# DATABASE & AUTHENTICATION
# ==============================================================================
# PostgreSQL Connection (Neon, Supabase, Local Docker)
DATABASE_URL="postgres://postgres:password@localhost:5432/momentum"

# Better Auth Secret (Generate via: openssl rand -base64 32)
BETTER_AUTH_SECRET="your_better_auth_secret"
BETTER_AUTH_URL="http://localhost:3000"
VITE_BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ==============================================================================
# UNIVERSAL AI GATEWAY & 9ROUTER
# ==============================================================================
# 9Router Local/VPS Gateway (default port: http://localhost:20128/v1)
AI_GATEWAY_URL="http://localhost:20128/v1"
AI_GATEWAY_KEY="sk-9router-local"
AI_DEFAULT_PROVIDER="9router" # 9router | gemini | openai | anthropic | deepseek | groq | openrouter | ollama
AI_DEFAULT_MODEL="llama-3.3-70b-versatile"

# ==============================================================================
# DIRECT AI PROVIDERS (Any or all can be set for automatic failover fallback)
# ==============================================================================
# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=""

# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=""

# Groq (https://console.groq.com/keys)
GROQ_API_KEY="your_groq_api_key"

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Ollama Local (http://localhost:11434/v1)
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ==============================================================================
# AUTOMATION & INTEGRATIONS (n8n & HERMES AGENT)
# ==============================================================================
# n8n Webhook Outbound Trigger URL
N8N_WEBHOOK_URL="http://localhost:5678/webhook/momentum-events"
# Shared Secret for validating inbound/outbound n8n requests
N8N_WEBHOOK_SECRET="your_n8n_secret_token"

# Hermes Autonomous Agent API Key (Nous Research)
HERMES_API_KEY="hermes_bearer_secret_token"

# ==============================================================================
# EMAIL & ADMIN SERVICES
# ==============================================================================
# Resend API Key for Email Service (https://resend.com/api-keys)
RESEND_API_KEY="your_resend_api_key"

# ID from Table authorized user (Optional - for admin features on page /feedback)
AUTHORIZED_USER_ID="your_authorized_user_id"
